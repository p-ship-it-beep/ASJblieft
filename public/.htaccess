# ASJblieft – Apache-instellingen (Yourname / shared hosting)
Options -MultiViews
RewriteEngine On
RewriteBase /

# Optioneel: altijd naar https://www. (haal de # weg zodra SSL actief is)
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.asjblieft.nl%{REQUEST_URI} [L,R=301]

# React Router: alle onbekende paden naar index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
